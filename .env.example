# Export these variables in your shell; this file is not automatically loaded.
DOCULENS_DATA_DIR=data
DOCULENS_EMBEDDINGS=on
DOCULENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCULENS_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Default evidence mode makes no LLM calls.
DOCULENS_LLM_PROVIDER=none
# For a local or remote OpenAI-compatible chat-completions endpoint:
# DOCULENS_LLM_PROVIDER=openai-compatible
# DOCULENS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DOCULENS_LLM_MODEL=YOUR_INSTALLED_MODEL
# DOCULENS_LLM_API_KEY=YOUR_KEY_IF_REQUIRED
# Amazon Bedrock (install the bedrock extra and configure AWS credentials):
# DOCULENS_LLM_PROVIDER=bedrock
# DOCULENS_LLM_MODEL=YOUR_CONVERSE_MODEL_OR_INFERENCE_PROFILE_ID
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# Optional current provider prices; no pricing is assumed or fetched automatically.
# DOCULENS_INPUT_USD_PER_MILLION=YOUR_INPUT_RATE
# DOCULENS_OUTPUT_USD_PER_MILLION=YOUR_OUTPUT_RATE
